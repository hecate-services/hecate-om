{application, hecate_om, [
    {description, "Hecate-over-mesh: shared substrate for hecate-* service daemons"},
    {vsn, "0.16.3"},
    {registered, [hecate_om_sup]},
    {mod, {hecate_om_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        cowboy,
        jsx,
        macula,
        %% Used by hecate_om_store when a service module exports
        %% store_id/0 + data_dir/0. Hard deps so CMD/PRJ services
        %% get the canonical reckon-db + evoq wiring for free.
        reckon_db,
        evoq,
        reckon_evoq,

        %% Used by hecate_om_read_model when a service module exports
        %% read_model_id/0 + data_dir/0. Same shape as the reckon-db deps
        %% above: starts idle (no database opened) until a service asks.
        barrel_docdb
    ]},
    {env, [
        %% Service-principal cert path. The container mounts
        %% /etc/hecate/secrets/<service-name> read-only on this path
        %% (Quadlet maps the per-service host directory to it).
        {service_cert_path, "/etc/hecate/secrets/service-cert.pem"},

        %% Realm tag (32-byte binary). Operator pins this via the
        %% per-service env file in hecate-gitops. May also be supplied
        %% as a 64-char hex binary. v2 will extract from the
        %% service-principal cert instead.
        %% {realm, <<...32 bytes...>>}

        %% Station seeds the service dials over QUIC. Each seed is a
        %% binary URL ("quic://host:port"), a string, or a map
        %% (#{host=>..., port=>...}). Empty list = run offline (the
        %% service stays up but can't reach the mesh).
        %%
        %% Precedence: the MACULA_STATION_SEEDS env var (comma-separated
        %% URLs) overrides this list when set — lets one deployed image
        %% dial a distinct station per instance without a rebuild. See
        %% hecate_om_identity:configured_seeds/0.
        {station_seeds, []},

        %% Loopback health endpoint port.
        {health_port,       8470},

        %% Prefix for capability advertisements on the mesh bloom channel.
        {capability_topic,  <<"_mesh.cap.">>}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"GitHub", "https://github.com/hecate-services/hecate-om"}
    ]}
]}.
